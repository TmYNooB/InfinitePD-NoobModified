# Copy this file to android/keystore.properties on each development machine.
# Do NOT commit android/keystore.properties.

# Absolute path to your release keystore file
storeFile=C:/Users/YourUser/.keys/infinitepd-release.jks

# Keystore password
storePassword=CHANGE_ME

# Alias name inside the keystore
keyAlias=infinitepd

# Password for the alias key
keyPassword=CHANGE_ME
